{
  "compilerOptions": {
    "module": "NodeNext",
    "moduleResolution": "NodeNext",

    "target": "ESNext",

    "types": ["node"],

    "strict": true,

    "sourceMap": true,

    "declaration": true,
    "declarationMap": true,

    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,

    "isolatedModules": true,

    "moduleDetection": "force",

    "skipLibCheck": true,

    "esModuleInterop": true,

    "resolveJsonModule": true
  },

  "include": [
    "src/**/*.ts"
  ],

  "exclude": [
    "node_modules",
    "dist"
  ]
}